GEMINI_API_KEY=your_gemini_api_key_here

# Required. Free key from data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_api_key_here

# Comma-separated allowed origins. Production: exact domain only, no wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# Max image upload size in megabytes
MAX_IMAGE_SIZE_MB=5

# Rate limits (slowapi format)
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_CHAT=20/minute
