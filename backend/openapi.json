{
  "openapi": "3.1.0",
  "info": {
    "title": "Farm Decision Assistant API",
    "description": "Backend API for the Multilingual AI Farm Decision Assistant. Provides farming advice, crop recommendations, disease identification, weather forecasts, mandi prices, and fertilizer guidance.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat With Assistant",
        "description": "Send a message and receive farming advice in the user's language.\n\nChat history is passed from the client; nothing is stored server-side.",
        "operationId": "chat_with_assistant_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/crop/recommend": {
      "post": {
        "tags": [
          "Crop"
        ],
        "summary": "Recommend Crop",
        "description": "Get crop recommendations based on location, soil, season, and water availability.\n\nFetches current weather for context, then asks Gemini for recommendations.",
        "operationId": "recommend_crop_api_crop_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CropRecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropRecommendResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/disease/identify": {
      "post": {
        "tags": [
          "Disease"
        ],
        "summary": "Identify Disease",
        "description": "Upload a leaf photo to identify disease and get treatment steps.\n\nPipeline: validate magic bytes, strip EXIF, resize, send to Gemini Vision.\nIf Gemini is uncertain, the response says so explicitly.",
        "operationId": "identify_disease_api_disease_identify_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_identify_disease_api_disease_identify_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiseaseIdentifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/weather": {
      "get": {
        "tags": [
          "Weather"
        ],
        "summary": "Get Weather",
        "description": "Get weather forecast and farming advice for a location.\n\nFetches real data from Open-Meteo. Farming advice is generated\nby Gemini based on the forecast (Phase 2).",
        "operationId": "get_weather_api_weather_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 37.0,
              "minimum": 6.0,
              "description": "Latitude",
              "title": "Lat"
            },
            "description": "Latitude"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 97.5,
              "minimum": 68.0,
              "description": "Longitude",
              "title": "Lon"
            },
            "description": "Longitude"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/LanguageCode",
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/mandi/prices": {
      "get": {
        "tags": [
          "Mandi"
        ],
        "summary": "Get Mandi Prices",
        "description": "Look up mandi commodity prices from Agmarknet (data.gov.in).\n\nResults are cached for 1 hour. Source and last-updated time are always shown.\nIf data.gov.in is unreachable, returns a clear error, never fake data.",
        "operationId": "get_mandi_prices_api_mandi_prices_get",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 50,
              "description": "State name",
              "title": "State"
            },
            "description": "State name"
          },
          {
            "name": "district",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50,
              "title": "District"
            }
          },
          {
            "name": "commodity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50,
              "title": "Commodity"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/LanguageCode",
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MandiPriceResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/fertilizer/guide": {
      "post": {
        "tags": [
          "Fertilizer"
        ],
        "summary": "Get Fertilizer Guide",
        "description": "Get general fertilizer and pesticide guidance.\n\nThis endpoint never returns specific chemical dosages.\nIt provides general type guidance (e.g. \"nitrogen-based fertilizer\"),\napplication timing, safety practices, and always refers the user to:\n1. The product label for exact dosage\n2. Their local Krishi Vigyan Kendra for expert advice",
        "operationId": "get_fertilizer_guide_api_fertilizer_guide_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FertilizerGuideRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FertilizerGuideResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/location/states": {
      "get": {
        "tags": [
          "Location"
        ],
        "summary": "Get States",
        "description": "Get list of Indian states with their districts.\n\nThis is static data bundled with the application.\nUsed to populate state/district dropdowns in the frontend.",
        "operationId": "get_states_api_location_states_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StateInfo"
                  },
                  "type": "array",
                  "title": "Response Get States Api Location States Get"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/location/geocode": {
      "get": {
        "tags": [
          "Location"
        ],
        "summary": "Geocode",
        "description": "Convert a district and state name to lat/lon coordinates.\n\nUses Open-Meteo geocoding API. Returns None if no match found.",
        "operationId": "geocode_api_location_geocode_get",
        "parameters": [
          {
            "name": "district",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "title": "District"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "title": "State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/GeocodingResult"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Geocode Api Location Geocode Get"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Simple health check endpoint.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdviceCategory": {
        "type": "string",
        "enum": [
          "sowing",
          "irrigation",
          "spraying",
          "harvesting",
          "general"
        ],
        "title": "AdviceCategory"
      },
      "ApiError": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError"
      },
      "Body_identify_disease_api_disease_identify_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "Leaf photo, JPEG or PNG, max 5 MB"
          },
          "lang": {
            "$ref": "#/components/schemas/LanguageCode",
            "default": "en"
          },
          "crop_name": {
            "type": "string",
            "maxLength": 100,
            "title": "Crop Name",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_identify_disease_api_disease_identify_post"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^(user|assistant)$",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "lang": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "title": "History"
          },
          "location": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Optional {lat, lon} for contextual answers"
          }
        },
        "type": "object",
        "required": [
          "message",
          "lang"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "lang": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "lang",
          "disclaimer"
        ],
        "title": "ChatResponse"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "Confidence"
      },
      "CropRecommendRequest": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 37.0,
            "minimum": 6.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 97.5,
            "minimum": 68.0,
            "title": "Lon"
          },
          "soil_type": {
            "$ref": "#/components/schemas/SoilType"
          },
          "season": {
            "$ref": "#/components/schemas/Season"
          },
          "water_availability": {
            "$ref": "#/components/schemas/WaterAvailability"
          },
          "lang": {
            "$ref": "#/components/schemas/LanguageCode"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon",
          "soil_type",
          "season",
          "water_availability",
          "lang"
        ],
        "title": "CropRecommendRequest"
      },
      "CropRecommendResponse": {
        "properties": {
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/CropRecommendation"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Recommendations"
          },
          "lang": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "weather_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather Summary"
          }
        },
        "type": "object",
        "required": [
          "lang",
          "disclaimer"
        ],
        "title": "CropRecommendResponse"
      },
      "CropRecommendation": {
        "properties": {
          "crop_name": {
            "type": "string",
            "title": "Crop Name"
          },
          "suitability_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Suitability Score"
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning"
          },
          "expected_duration_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Duration Days"
          },
          "water_requirement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Water Requirement"
          }
        },
        "type": "object",
        "required": [
          "crop_name",
          "suitability_score",
          "reasoning"
        ],
        "title": "CropRecommendation"
      },
      "CurrentWeather": {
        "properties": {
          "temp_c": {
            "type": "number",
            "title": "Temp C"
          },
          "humidity_percent": {
            "type": "number",
            "title": "Humidity Percent"
          },
          "precipitation_mm": {
            "type": "number",
            "title": "Precipitation Mm"
          },
          "wind_speed_kmh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wind Speed Kmh"
          },
          "weather_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
